import '../styles/style.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import { client, type StaffItem } from '../library/microcms';

// トップページ用に最新3件のお知らせを取得
let newsList = [];

try {
  const response = await client.get({
    endpoint: "news",
    queries: {
      orders: "-publishedAtCustom",
      limit: 3,
    },
  });

  newsList = response.contents ?? [];
} catch (error) {
  console.warn("お知らせを取得できませんでした。", error);
}

// TOPページ用に最新3件のギャラリーを取得
let topGalleryList = [];

try {
  const galleryResponse = await client.get({
    endpoint: "gallery",
    queries: {
      limit: 100,
      orders: "-updatedAt",
    },
  });

  topGalleryList = (galleryResponse.contents ?? [])
    .filter((item: any) => item.isTop === true)
    .slice(0, 3);
} catch (error) {
  console.warn("ギャラリーを取得できませんでした。", error);
}


// TOPページ用に表示したいメニューを取得
let topMenuList = [];

try {
  const menuResponse = await client.get({
    endpoint: "menu",
    queries: {
      limit: 100,
      orders: "sortOrder",
    },
  });

  topMenuList = (menuResponse.contents ?? [])
    .filter((item: any) => item.isTop === true)
    .slice(0, 5);
} catch (error) {
  console.warn("メニューを取得できませんでした。", error);
}


// pages APIから pageId が top のデータを取得
const topPageData = await client.get({
  endpoint: 'pages',
  queries: { filters: 'pageId[equals]top' },
}).then(res => res.contents[0]).catch(() => null);

// pages APIから pageId が concept のデータを取得
const conceptPageData = await client.get({
  endpoint: 'pages',
  queries: { filters: 'pageId[equals]concept' },
}).then(res => res.contents[0]).catch(() => null);

// STAFF（オーナー・代表者）情報を取得

let topStaff: StaffItem | undefined;

try {
  const staffResponse = await client.get({
    endpoint: "staff",
    queries: {
      limit: 1,
      orders: "sortOrder",
    },
  });

  topStaff = staffResponse.contents?.[0];
} catch (error) {
  console.warn("スタッフ情報を取得できませんでした。", error);
}


// pages APIから pageId が reservation のデータを取得
const reservationPageData = await client.get({
  endpoint: 'pages',
  queries: { filters: 'pageId[equals]reservation' },
}).then(res => res.contents[0]).catch(() => null);


// pages APIから pageId が common のデータを取得（フッターおよびACCESS共通）
const commonData = await client.get({
  endpoint: 'pages',
  queries: { filters: 'pageId[equals]common' },
}).then(res => res.contents[0]).catch(() => null);


// --- 1. カレンダー用の日付準備とmicroCMS（commonData）からの例外データ解析 ---
const today = new Date();
const year = today.getFullYear();
const month = today.getMonth() + 1;

const exceptionMap = {};

if (commonData?.calendarExceptions) {
  const rawHtml = commonData.calendarExceptions;
  
  // 修正：ハイフン・スラッシュだけでなく「2026年10月5日」のような書き方にも対応する正規表現
  const regex = /(\d{4})[年/-](\d{1,2})[月/-](\d{1,2})日?[^\d<]*([^<]*)/g;
  let match;

  while ((match = regex.exec(rawHtml)) !== null) {
    const y = parseInt(match[1], 10);
    const m = parseInt(match[2], 10);
    const d = parseInt(match[3], 10);
    const text = match[4].trim();
    
    // 今月（当月）のデータに絞る
    if (y === year && m === month) {
      const isOff = !text.includes('営業'); 
      
      exceptionMap[d] = {
        type: isOff ? 'off' : 'open',
        title: text
      };
    }
  }
}

// --- 2. カレンダーの自動生成ロジック（例外対応版） ---
const firstDayIndex = new Date(year, month - 1, 1).getDay();
const lastDayDate = new Date(year, month, 0).getDate();

const calendarRows = [];
let daysInWeek = [];

for (let i = 0; i < firstDayIndex; i++) {
  daysInWeek.push({ day: '', isOff: false, isCurrentMonth: false });
}

for (let d = 1; d <= lastDayDate; d++) {
  const currentLoopDate = new Date(year, month - 1, d);
  const dayOfWeek = currentLoopDate.getDay(); 
  const dateNum = currentLoopDate.getDate();

  // 月曜日(1)の場合、何回目の月曜日かを計算する（例: 1〜7日は第1、8〜14日は第2...）
  const weekNumber = Math.ceil(dateNum / 7);

  // 基本の定休日判定：毎週月曜日(1) を定休日とする
  let isOffDay = (dayOfWeek === 1); 

  // microCMSから取得した例外データ（臨時休業・臨時営業）があれば上書き
  if (exceptionMap[d]) {
    if (exceptionMap[d].type === 'off') {
      isOffDay = true;  
    } else if (exceptionMap[d].type === 'open') {
      isOffDay = false; 
    }
  }

  daysInWeek.push({
    day: d,
    isOff: isOffDay,
    isSun: dayOfWeek === 0,
    isSat: dayOfWeek === 6,
    isCurrentMonth: true
  });

  if (daysInWeek.length === 7) {
    calendarRows.push(daysInWeek);
    daysInWeek = [];
  }
}


if (daysInWeek.length > 0) {
  while (daysInWeek.length < 7) {
    daysInWeek.push({ day: '', isOff: false, isCurrentMonth: false });
  }
  calendarRows.push(daysInWeek);
}

