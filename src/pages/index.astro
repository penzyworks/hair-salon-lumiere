              <div class="calendar-brand">{commonData?.shopName || "HAIR SALON LUMIÈRE"}</div>
              <div class="calendar-header">
                <span class="calendar-month">{year}.{String(month).padStart(2, '0')} CALENDAR</span>
              </div>

              <table class="calendar-table">
                <thead>
                  <tr>
                    <th class="sun">日</th><th>月</th><th>火</th><th>水</th><th>木</th><th>金</th><th class="sat">土</th>
                  </tr>
                </thead>
                <tbody>
                  {calendarRows.map((week) => (
                    <tr>
                      {week.map((item) => (
                        <td
                          class:list={{
                            disabled: !item.isCurrentMonth,
                            off: item.isCurrentMonth && item.isOff,
                            sun: item.isCurrentMonth && item.isSun && !item.isOff,
                            sat: item.isCurrentMonth && item.isSat && !item.isOff,
                          }}
                        >
                          {item.day}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>


              <p class="calendar-note"><span class="mark-off">●</span> 赤い枠と数字の日が定休日です</p>
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>

  <!-- トップへ戻るボタン -->
  <a href="#" id="scrollTopBtn" class="scroll-top-btn" aria-label="ページトップへ戻る">↑</a>

  <!-- Footer -->
  <Footer isHome={true} />

  <!-- JavaScript -->
  <script src="../scripts/main.js"></script>

</body>
</html>