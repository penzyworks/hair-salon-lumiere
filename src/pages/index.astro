        <span class="section-en">GALLERY</span>
        <h2 class="section-title">スタイルギャラリー</h2>
        <p class="gallery-lead">写真をクリックすると角度（正面・横・後ろ）が切り替わります</p>

        <div class="gallery-grid">
          {topGalleryList && topGalleryList.length > 0 ? (
            topGalleryList.map((item) => {
              const angles = (item.images || []).map((img: any) => {
                let url = '';
                if (img?.src?.url) url = img.src.url;
                else if (typeof img?.src === 'string') url = img.src;
                else if (img?.url) url = img.url;
                
                return {
                  src: url,
                  label: img?.label || 'FRONT'
                };
              }).filter((a: any) => a.src !== '');

              const defaultSrc = angles.length > 0 ? angles[0].src : '';
              const defaultLabel = angles.length > 0 ? angles[0].label : 'FRONT';

              return (
                <div class="gallery-card">
                  <div class="gallery-img-box">
                    <span class="angle-badge">{defaultLabel}</span>
                    {defaultSrc ? (
                      <img 
                        src={defaultSrc} 
                        data-angles={JSON.stringify(angles)} 
                        data-index="0" 
                        alt={item.styleName || 'スタイル画像'} 
                      />
