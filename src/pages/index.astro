        <p class="hero-sub">{topPageData?.heroSub || "PRIVATE HAIR SALON"}</p>
      </div>

      <div class="carousel">
        <div class="carousel-slides">
          {topPageData?.heroImages && topPageData.heroImages.length > 0 ? (
            topPageData.heroImages.map((item: any, index: number) => (
              <div class={`slide ${index === 0 ? 'active' : ''}`}>
                <img src={item.image?.url} alt={`サロンメイン画像 ${index + 1}`} />
              </div>
            ))
          ) : (
            <div class="slide active">
              <img src="https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=1600&q=80" alt="サロン内観">
            </div>
          )}
        </div>

        <!-- 左右矢印コントロール -->
        <button class="carousel-arrow prev" id="prevBtn" aria-label="前の画像へ">‹</button>
        <button class="carousel-arrow next" id="nextBtn" aria-label="次の画像へ">›</button>

        <!-- 下部ドットインジケーター -->
        <div class="carousel-dots" id="dotsContainer">
          {topPageData?.heroImages && topPageData.heroImages.length > 0 ? (
            topPageData.heroImages.map((_, index: number) => (
              <button class={`dot ${index === 0 ? 'active' : ''}`} data-index={index}></button>
            ))
          ) : (
            <button class="dot active" data-index="0"></button>
          )}
        </div>
      </div>
    </section>

<!-- 3. CONCEPT -->
<section id="concept" class="section concept-section fade-in">
